NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Canonical production URL for SEO (Open Graph, sitemap, robots), e.g. https://rampungin.com
# Disqus shortname only (from https://disqus.com/admin/create/) — e.g. rampungin
# Do NOT use rampungin.disqus.com or a full URL
NEXT_PUBLIC_DISQUS_SHORTNAME=

# About / donation (optional — shown on /about + after "Hasilkan prompt")
NEXT_PUBLIC_CREATOR_USERNAME=agungtsp
# Saweria page URL (opens in new tab — not QR widget embed)
# Example: https://saweria.co/agungtsp
NEXT_PUBLIC_DONATE_SAWERIA=https://saweria.co/agungtsp
NEXT_PUBLIC_DONATE_TRAKTEER=
NEXT_PUBLIC_DONATE_PAYPAL=
NEXT_PUBLIC_DONATE_URL=
NEXT_PUBLIC_DONATE_LABEL=
NEXT_PUBLIC_DONATE_BANK_NAME=
NEXT_PUBLIC_DONATE_BANK_ACCOUNT=
NEXT_PUBLIC_DONATE_BANK_HOLDER=

# Analytics (optional — leave empty to disable)
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Histats site ID (numeric), from https://www.histats.com/
NEXT_PUBLIC_HISTATS_ID=
