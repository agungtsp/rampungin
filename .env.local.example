NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Canonical production URL for SEO (Open Graph, sitemap, robots), e.g. https://rampungin.com
# Disqus shortname only (from https://disqus.com/admin/create/) — e.g. rampungin
# Do NOT use rampungin.disqus.com or a full URL
NEXT_PUBLIC_DISQUS_SHORTNAME=

# About / donation (optional — shown on /about + after "Hasilkan prompt")
NEXT_PUBLIC_CREATOR_USERNAME=agungtsp
# Saweria page URL (opens in new tab — not QR widget embed)
# Example: https://saweria.co/agungtsp
NEXT_PUBLIC_DONATE_SAWERIA=https://saweria.co/agungtsp
NEXT_PUBLIC_DONATE_TRAKTEER=
NEXT_PUBLIC_DONATE_PAYPAL=
NEXT_PUBLIC_DONATE_URL=
NEXT_PUBLIC_DONATE_LABEL=
NEXT_PUBLIC_DONATE_BANK_NAME=
NEXT_PUBLIC_DONATE_BANK_ACCOUNT=
NEXT_PUBLIC_DONATE_BANK_HOLDER=

# Rampungin Labs — native intake form (stored in Supabase + Telegram alert)
# Server-only (never NEXT_PUBLIC_):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Analytics (optional — leave empty to disable)
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
# Required for page views + events (generate, copy, save, search, login, share)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Histats site ID (numeric), from https://www.histats.com/
NEXT_PUBLIC_HISTATS_ID=

# After applying supabase/migrations/20260725160000_prompt_pins.sql, grant admin:
#   update public.profiles set is_admin = true where username = 'your-username';
# Admin can pin prompts to homepage / category from the prompt detail page.
# Authors can pin up to 10 public prompts to Editor Picks (/editor-picks).

# AI catalog seed (npm run seed:ai)
# SEED_USERNAME=agungtsp
# SEED_AUTHOR_ID=
# SEED_SKIP_IMAGES=1

